#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
              &kp Q  &kp W  &kp F          &kp P      &kp B               &kp J            &kp L            &kp U      &kp Y    &kp SEMI
              &kp A  &kp R  &kp S          &kp T      &kp G               &kp M            &kp N            &kp E      &kp I    &kp O
&lt 3 ESCAPE  &kp Z  &kp X  &kp C          &kp D      &kp V               &kp K            &kp H            &kp COMMA  &kp DOT  &kp FSLH  &kp LCTRL
                            &kp LEFT_META  &lt 1 TAB  &mt LSHIFT SPACE    &mt LCTRL ENTER  &lt 2 BACKSPACE  &kp LALT
            >;
        };

        NUM {
            bindings = <
        &trans  &kp N7  &kp N8  &kp N9  &trans    &trans          &trans          &trans        &trans           &trans
        &kp N0  &kp N4  &kp N5  &kp N6  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans  &trans
                        &trans  &trans  &trans    &trans          &trans          &trans
            >;
        };

        SYM {
            bindings = <
        &kp TILDE        &kp UNDERSCORE  &kp PLUS   &kp DOUBLE_QUOTES  &trans         &trans     &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE
        &kp EXCLAMATION  &kp AT_SIGN     &kp HASH   &kp DOLLAR         &kp PERCENT    &kp CARET  &kp AMPERSAND      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ASTERISK
&trans  &kp GRAVE        &kp MINUS       &kp EQUAL  &kp SQT            &trans         &trans     &kp SQT            &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH  &trans
                                         &trans     &trans             &trans         &trans     &trans             &trans
            >;
        };

        CONFIG {
            bindings = <
        &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &trans     &kp F1    &kp F2     &kp F3  &kp F10
        &trans  &trans        &trans        &trans        &tog 4        &trans     &kp F4    &kp F5     &kp F6  &kp F11
&trans  &trans  &trans        &trans        &trans        &trans        &trans     &kp F7    &kp F8     &kp F9  &kp F12  &trans
                              &kp LCTRL     &kp LALT      &kp LSHFT     &kp LSHFT  &kp RGUI  &kp RCTRL
            >;
        };

        GAME {
            bindings = <
         &kp TAB    &kp Q  &kp X      &kp E     &kp R        &trans  &trans  &trans  &trans  &trans
         &kp LSHFT  &kp A  &kp W      &kp D     &kp F        &trans  &trans  &trans  &trans  &trans
&kp ESC  &sl 5      &kp Z  &kp S      &kp C     &kp V        &trans  &trans  &trans  &trans  &trans  &trans
                           &kp LCTRL  &kp LALT  &kp SPACE    &trans  &trans  &trans
            >;
        };

        GAME2 {
            bindings = <
        &trans  &trans  &trans  &kp T   &kp Y     &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &kp G   &kp H     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp B   &kp N     &trans  &trans  &trans  &trans  &trans  &trans
                        &kp N3  &kp N2  &kp N1    &trans  &trans  &trans
            >;
        };
    };
};

